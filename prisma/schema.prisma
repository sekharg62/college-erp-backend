generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

enum StudentActivitySubmitStatus {
  PENDING
  APPROVE
  REJECT
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Institute {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  instituteCode  String   @unique
  location       String
  contactDetails String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  admins         Admin[]
  teachers       Teacher[]
  students       Student[]
}

model Admin {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @db.Uuid
  name        String
  phoneNo     String
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teachers  Teacher[]
  students  Student[]

  @@index([instituteId])
}

model Teacher {
  id           String   @id @default(uuid()) @db.Uuid
  instituteId  String   @db.Uuid
  adminId      String   @db.Uuid
  departmentId String   @db.Uuid
  name         String
  phoneNo      String
  password     String
  signature    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute  Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  admin      Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students   Student[]

  @@index([instituteId])
  @@index([adminId])
  @@index([departmentId])
}

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  teacherId      String   @db.Uuid
  adminId        String   @db.Uuid
  instituteId    String   @db.Uuid
  name           String
  rollNo         String   @unique
  admissionYear  String
  phoneNo        String?
  password       String
  signature      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher          Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  admin            Admin                   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  institute        Institute               @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  activitySubmits  StudentActivitySubmit[]

  @@index([teacherId])
  @@index([adminId])
  @@index([instituteId])
}

model StudentActivitySubmit {
  id            String                      @id @default(uuid()) @db.Uuid
  studentId     String                      @db.Uuid
  activityId    String
  subActivityId String
  academicYear  String
  points        Int
  proofUrl      String
  status        StudentActivitySubmitStatus @default(PENDING)
  notes         String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([activityId])
  @@index([subActivityId])
  @@index([status])
  @@map("student_activity_submit")
}

model Department {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  departmentCode String     @unique
  slug           String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  teachers       Teacher[]
  semesters      Semester[]
  subjects       Subject[]
}

model Semester {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @db.Uuid
  number       Int
  label        String?   @db.VarChar(50)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects   Subject[]

  @@unique([departmentId, number])
  @@index([departmentId])
  @@map("semesters")
}

model Subject {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @db.Uuid
  semesterId   String   @db.Uuid
  name         String   @db.VarChar(150)
  slug         String   @db.VarChar(150)
  subjectCode  String?  @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([semesterId, slug])
  @@index([departmentId])
  @@index([semesterId])
  @@map("subjects")
}
