PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Pooled connection (app runtime) — Supabase: port 6543 + ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection (migrations) — Supabase: port 5432
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# If your password contains special characters (? @ # etc.), URL-encode them.
# Example: "p?ss" becomes "p%3Fss"

JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
